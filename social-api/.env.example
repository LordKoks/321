DATABASE_URL=postgresql+asyncpg://user:password@db:5432/social_api
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-32-char-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# VK OAuth
VK_APP_ID=
VK_APP_SECRET=
VK_REDIRECT_URI=http://localhost:8000/accounts/vk/callback

# X (Twitter) OAuth2 PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/accounts/x/callback

# Telegram MTProto
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# OK (Odnoklassniki) OAuth2
OK_APP_ID=
OK_APP_SECRET=
OK_PUBLIC_KEY=
OK_REDIRECT_URI=http://localhost:8000/accounts/ok/callback

# Google / YouTube OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/youtube/callback

# Optional proxy for Telegram (10+ accounts)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASSWORD=

# Job APIs (free tiers with keys)
RAPIDAPI_KEY=          # Glassdoor via RapidAPI — 100 req/mo free
THEIRSTACK_API_KEY=    # TheirStack — 200 credits/mo free
SERPAPI_KEY=           # SerpApi Google Jobs — 100 searches/mo free
